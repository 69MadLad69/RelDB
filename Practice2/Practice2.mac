ROUTINE Practice2.Practice2
Practice2Practice2 ;
 NEW choice
 FOR  DO  QUIT:choice="0"  
 . WRITE !,"--- Hospital Management System ---"
 . WRITE !,"1. Add Patient"
 . WRITE !,"2. Remove Patient"
 . WRITE !,"3. List Patients"
 . WRITE !,"4. Add Staff"
 . WRITE !,"5. Remove Staff"
 . WRITE !,"6. List Staff"
 . WRITE !,"7. Find Patient by ID"
 . WRITE !,"8. Find Staff by ID"
 . WRITE !,"9. Add Visit to Patient"
 . WRITE !,"0. Exit"
 . WRITE !,"Enter choice: "
 . READ choice
 . IF choice="1" DO AddPatient
 . ELSE  IF choice="2" DO RemovePatient
 . ELSE  IF choice="3" DO ListPatients
 . ELSE  IF choice="4" DO AddStaff
 . ELSE  IF choice="5" DO RemoveStaff
 . ELSE  IF choice="6" DO ListStaff
 . ELSE  IF choice="7" DO FindPatientByID
 . ELSE  IF choice="8" DO FindStaffByID
 . ELSE  IF choice="9" DO AddVisitToPatient

 QUIT

AddPatient
 WRITE !,"Enter patient name: "
 READ name
 WRITE !,"Enter patient ID: "
 READ id
 WRITE !,"Enter room number: "
 READ room
 WRITE !,"Enter diagnosis: "
 READ diag
 WRITE !,"Enter staff treating this patient (comma-separated): "
 READ stafflist
 WRITE !,"Enter first visit date (YYYY-MM-DD): "
 READ visitDate
 WRITE !,"Enter allergies (comma-separated, or leave empty if none): "
 READ allergiesStr

 NEW year SET year=$PIECE(visitDate,"-",1)

 SET ^Patients(id,"Name")=name
 SET ^Patients(id,"Room")=room
 SET ^Patients(id,"Diagnosis")=diag
 SET ^Patients(id,"Staff")=stafflist

 IF $GET(allergiesStr)'="" DO
 . SET ^Patients(id,"Allergies")=$LISTFROMSTRING(allergiesStr,",")
 ELSE  DO
 . SET ^Patients(id,"Allergies")=$LISTBUILD()

 SET ^Patients(id,"Visits",year,1)=visitDate

 WRITE !,"Patient ",name," added."
 QUIT

RemovePatient
 WRITE !,"Enter patient ID to remove: "
 READ id
 IF '$DATA(^Patients(id)) WRITE !,"Patient not found." QUIT
 KILL ^Patients(id)
 WRITE !,"Patient removed."
 QUIT

FindPatientByID
 WRITE !,"Enter patient ID: "
 READ pid
 IF '$DATA(^Patients(pid)) WRITE !,"Patient not found." QUIT

 WRITE !,"ID: ",pid
 WRITE !," Name: ",$GET(^Patients(pid,"Name"))
 WRITE !," Room: ",$GET(^Patients(pid,"Room"))
 WRITE !," Diagnosis: ",$GET(^Patients(pid,"Diagnosis"))
 WRITE !," Treating Staff: ",$GET(^Patients(pid,"Staff"))

 NEW allergyOut
 IF $LISTVALID(^Patients(pid,"Allergies")) DO
 . SET allergyOut = $LISTTOSTRING(^Patients(pid,"Allergies"),",",1)
 ELSE  SET allergyOut = $GET(^Patients(pid,"Allergies"),"(none)")

 WRITE !," Allergies: ",allergyOut

 WRITE !," Visits: "
 NEW year,vid
 SET year=""
 FOR  SET year=$ORDER(^Patients(pid,"Visits",year)) QUIT:year=""  DO
 . SET vid=""
 . FOR  SET vid=$ORDER(^Patients(pid,"Visits",year,vid)) QUIT:vid=""  DO
 . . WRITE ^Patients(pid,"Visits",year,vid)," "
 WRITE !
 QUIT


AddVisitToPatient
 WRITE !,"Enter patient ID: "
 READ pid
 IF '$DATA(^Patients(pid)) WRITE !,"Patient not found." QUIT

 WRITE !,"Enter new visit date (YYYY-MM-DD): "
 READ newVisit

 NEW year SET year=$PIECE(newVisit,"-",1)

 NEW last SET last=$ORDER(^Patients(pid,"Visits",year,""),-1)
 IF last="" SET last=0

 SET ^Patients(pid,"Visits",year,last+1)=newVisit

 WRITE !,"New visit added for patient ",$GET(^Patients(pid,"Name"))
 QUIT

ListPatients
 WRITE !!,"--- ALL PATIENT RECORDS ---",!
 
 NEW pid SET pid=""
 FOR  SET pid=$ORDER(^Patients(pid)) QUIT:pid=""  DO
 . WRITE !,"ID: ",pid
 . WRITE !," Name: ",$GET(^Patients(pid,"Name"))
 . WRITE !," Room: ",$GET(^Patients(pid,"Room"))
 . WRITE !," Diagnosis: ",$GET(^Patients(pid,"Diagnosis"))
 . WRITE !," Treating Staff: ",$GET(^Patients(pid,"Staff"))
 . NEW allergyOut
 . IF $LISTVALID(^Patients(pid,"Allergies")) DO
 . . SET allergyOut = $LISTTOSTRING(^Patients(pid,"Allergies"),",",1)
 . ELSE  SET allergyOut = $GET(^Patients(pid,"Allergies"),"(none)")
 . WRITE !," Allergies: ",allergyOut
 . WRITE !," Visit: "
 . NEW year,vid SET year=""
 . FOR  SET year=$ORDER(^Patients(pid,"Visits",year)) QUIT:year=""  DO
 . . SET vid=""
 . . FOR  SET vid=$ORDER(^Patients(pid,"Visits",year,vid)) QUIT:vid=""  DO
 . . . WRITE ^Patients(pid,"Visits",year,vid)," "
 . WRITE !

 QUIT

AddStaff
 WRITE !,"Enter staff name: "
 READ name
 WRITE !,"Enter staff ID: "
 READ id
 WRITE !,"Enter role (Doctor/Nurse/Ambulance): "
 READ role

 SET ^Staff(id,"Name")=name
 SET ^Staff(id,"Role")=role
 WRITE !,"Staff member ",name," added."
 QUIT

RemoveStaff
 WRITE !,"Enter staff ID to remove: "
 READ id
 IF '$DATA(^Staff(id)) WRITE !,"Staff not found." QUIT
 KILL ^Staff(id)
 WRITE !,"Staff removed."
 QUIT

FindStaffByID
 WRITE !,"Enter staff ID: "
 READ sid
 IF '$DATA(^Staff(sid)) WRITE !,"Staff not found." QUIT
 WRITE !,"ID: ",sid
 WRITE !," Name: ",^Staff(sid,"Name")
 WRITE !," Role: ",^Staff(sid,"Role"),!
 QUIT

ListStaff
 WRITE !!,"--- ALL STAFF RECORDS ---",!
 
 NEW sid SET sid=""
 FOR  SET sid=$ORDER(^Staff(sid)) QUIT:sid=""  DO
 . WRITE !,"ID: ",sid
 . WRITE !," Name: ",^Staff(sid,"Name")
 . WRITE !," Role: ",^Staff(sid,"Role"),!
 QUIT